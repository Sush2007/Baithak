# ==============================================================
# Supabase Configuration (Stateless PostgREST API)
# ==============================================================
# Baithak uses @supabase/supabase-js, meaning we DO NOT open raw 
# Postgres connections (5432) from Next.js serverless functions.
# All DB queries are routed via HTTPS (port 443) to PostgREST,
# which manages its own internal highly-optimized connection pool 
# (via Supavisor/PgBouncer). 
# 
# 👉 No connection limits will be exhausted. 
# 👉 No pool_size tuning is required on the Next.js side.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==============================================================
# Upstash Redis (Rate Limiting & Async Write Buffer Queue)
# ==============================================================
# Used by middleware.js for strict/default sliding window rate limits.
# Used by lib/queue.js for buffering high-concurrency non-critical writes.
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# ==============================================================
# Storage (Cloudflare R2 or Supabase Storage)
# ==============================================================
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-key
CLOUDFLARE_R2_BUCKET_NAME=baithak-media
NEXT_PUBLIC_R2_URL=https://your-r2-public-url.r2.dev

# ==============================================================
# Security & Analytics
# ==============================================================
ADMIN_SECRET_KEY=your-admin-secret-key-for-worker-endpoints
NEXT_PUBLIC_SITE_URL=http://localhost:5173

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Web Push VAPID Keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@baithakpe.com

# Resend API for Email Delivery
RESEND_API_KEY=re_your_resend_api_key
REPORT_EMAIL_TO=support@yourdomain.com
